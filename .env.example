APP_NAME=Jodohku
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=1.4.0
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# MySQL / MariaDB (production)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jodohku
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (Redis for queue/cache/session — SCALE P0):
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis

# --- Broadcasting / Realtime (Reverb) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Multi-node (P2, opt-in setelah K5: Redis pubsub + sticky LB di proxy):
# REVERB_SCALING_ENABLED=true
# REVERB_SCALING_CHANNEL=reverb

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Storage (local + S3-compatible) ---
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Queue ---
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=general
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default

# --- Cache ---
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_URL=

# --- Mail ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@jodohku.example.test"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=localhost

# --- Auth / Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_TOKEN_PREFIX=

# --- AI (OpenAI + OpenAI-compatible) ---
AI_ENABLED=true
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_PER_MIN=10
AI_RATE_PER_DAY=200
AI_MONTHLY_CAP_USD=50
AI_KILL_SWITCH=false
AI_SPEND_CACHE_TTL=300

# --- Search (Scout, opt-in — default null = no-op, LIKE path stays) ---
SCOUT_DRIVER=null
SCOUT_QUEUE=false
SCOUT_PREFIX=jodohku_
# Meilisearch (provision only after K1 shows search pain at ~100k users):
# SCOUT_DRIVER=meilisearch
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=

# --- Payments (gateways + webhook secrets; placeholders only, never commit real secrets) ---
PAYMENT_GATEWAY=midtrans
PAYMENT_CURRENCY=IDR

IPAYMU_ENABLED=false
IPAYMU_BASE_URL=https://sandbox.ipaymu.com/api/v2
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_CALLBACK_SECRET=

XENDIT_ENABLED=false
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=

MIDTRANS_ENABLED=false
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=

TRIPAY_ENABLED=false
TRIPAY_BASE_URL=https://tripay.co.id/api-sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_CALLBACK_SECRET=

# --- Feature flags ---
FEATURE_AI=true
FEATURE_VIRTUAL=true
FEATURE_VIDEO_CALL=false
FEATURE_COMMUNITY=true
FEATURE_CREDITS=true
FEATURE_GIFTS=true
FEATURE_BOOST=true
FEATURE_ADS=true
FEATURE_VERIFICATION=true

FREE_DAILY_LIKES=20

# --- Virtual member caps ---
VIRTUAL_MAX_DAILY=5
VIRTUAL_ACTIVE_FROM=8
VIRTUAL_ACTIVE_UNTIL=22

# --- Chat ---
CHAT_MSG_PER_MIN=20
CHAT_MSG_PER_HOUR=200
CHAT_REQUESTS_PER_DAY=30
CHAT_PREMIUM_MSG_PER_MIN=60
CHAT_PREMIUM_MSG_PER_HOUR=1000
CHAT_PREMIUM_REQUESTS_PER_DAY=200
CHAT_MAX_LENGTH=2000

# --- Matchmaking ---
MATCH_WEIGHT_AGE=10
MATCH_WEIGHT_LOCATION=10
MATCH_WEIGHT_PREFERENCE=20
MATCH_WEIGHT_PERSONALITY=20
MATCH_WEIGHT_INTEREST=10
MATCH_WEIGHT_LIFESTYLE=10
MATCH_WEIGHT_GOAL=10
MATCH_WEIGHT_BEHAVIOR=10
MATCH_MAX_DISTANCE_KM=200
MATCH_MIN_DAILY_SCORE=55
MATCH_DAILY_PICKS=10

# --- SEO ---
SEO_SITE_NAME=Jodohku
SEO_DEFAULT_TITLE="Jodohku — Temukan Jodohmu"
SEO_DEFAULT_DESCRIPTION="Platform biro jodoh modern Indonesia: matchmaking, chat aman, verifikasi, virtual member transparan."
SEO_CANONICAL_URL=http://localhost:8000
SEO_ROBOTS_INDEX=true

VITE_APP_NAME="${APP_NAME}"

# --- Demo photos (local development/demo seeding only) ---
# generated = abstract GD avatars (default, safe). local_library = synthetic
# faces from storage (see DEMO.md); operator owns the library licensing.
DEMO_PHOTO_DRIVER=generated
# DEMO_PHOTO_DRIVER=local_library
# DEMO_PHOTO_LIBRARY=demo/faces
# DEMO_PHOTO_LIBRARY_DISK=local

# --- Push notifications (default log driver = auditable no-op) ---
PUSH_DRIVER=log
# PUSH_DRIVER=fcm
# FCM v1 recommended (service-account JSON path or raw JSON):
# PUSH_FCM_PROJECT_ID=
# PUSH_FCM_SERVICE_JSON=
# Legacy fallback (deprecated by Google):
# PUSH_FCM_SERVER_KEY=

# --- Referral & affiliate ---
REFERRAL_DAILY_CAP=20
REFERRAL_REWARD_CREDITS=100
AFFILIATE_DEFAULT_RATE=0.10

# --- WebRTC (STUN always; TURN only when configured) ---
WEBRTC_STUN=stun:stun.l.google.com:19302
# WEBRTC_TURN_URL=
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=

# --- Boost ---
BOOST_POST_COST=50
